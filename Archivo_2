    <title>Radar de Antojos</title>
    <!-- Aquí traemos el estilo del mapa -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Aquí conectaremos nuestros propios colores más adelante -->
